{
  "compilerOptions": {
    "noEmit": true, // TODO might need to be removed
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules"]
}
